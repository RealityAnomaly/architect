{
  "private": true,
  "workspace": [
    "packages/*"
  ],
  "tasks": {
    "run": "deno run --check ./packages/architect/src/bin/architect.ts",
    "test": "deno test --allow-read --allow-write --allow-env",
    "check": "deno check packages/**/*.ts"
  },
  "compilerOptions": {
    "noImplicitReturns": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@es-toolkit/es-toolkit": "jsr:@es-toolkit/es-toolkit@^1.49.0",
    "@glassway/kubernetes-models": "jsr:@glassway/kubernetes-models@^1.36.4",
    "@glassway/kubernetes-types": "jsr:@glassway/kubernetes-types@^1.0.3",
    "@logtape/logtape": "jsr:@logtape/logtape@^2.2.3",
    "@std/assert": "jsr:@std/assert@^1.0.9",
    "@std/async": "jsr:@std/async@^1.5.0",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/streams": "jsr:@std/streams@^1.1.1",
    "@std/url": "jsr:@std/url@^0.225.1",
    "@std/yaml": "jsr:@std/yaml@^1.1.2",
    "commander": "npm:commander@^15.0.0",
    "ohash": "npm:ohash@^2.0.11",
    "semver": "npm:semver@^7.8.5"
  }
}
