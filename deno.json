{
  "private": true,
  "workspace": [
    "packages/*"
  ],
  "tasks": {
    "run": "deno run --check -A ./packages/architect/src/bin/architect.ts",
    "test": "deno test --allow-read --allow-write",
    "check": "deno check packages/**/*.ts"
  },
  "compilerOptions": {
    "noImplicitReturns": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@es-toolkit/es-toolkit": "jsr:@es-toolkit/es-toolkit@^1.49.0",
    "@std/assert": "jsr:@std/assert@^1.0.9",
    "@std/streams": "jsr:@std/streams@^1.1.1",
    "@std/yaml": "jsr:@std/yaml@^1.1.2",
    "ohash": "npm:ohash@^2.0.11",
    "re2-wasm": "npm:re2-wasm@^1.0.2"
  }
}
