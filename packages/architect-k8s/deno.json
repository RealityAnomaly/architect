{
  "imports": {
    "@es-toolkit/es-toolkit": "jsr:@es-toolkit/es-toolkit@^1.49.0",
    "@kubernetes/client-node": "npm:@kubernetes/client-node@^1.4.0",
    "@match/match": "jsr:@match/match@^0.1.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@types/js-yaml": "npm:@types/js-yaml@^4.0.9",
    "@types/lodash": "npm:@types/lodash@^4.17.24",
    "@types/object-hash": "npm:@types/object-hash@^3.0.6",
    "ajv": "npm:ajv@^8.20.0",
    "appdirsjs": "npm:appdirsjs@^1.2.7",
    "commander": "npm:commander@^12.1.0",
    "fast-glob": "npm:fast-glob@^3.3.3",
    "js-yaml": "npm:js-yaml@^4.3.0",
    "lodash": "npm:lodash@^4.18.1",
    "object-hash": "npm:object-hash@^3.0.0",
    "oci-client": "npm:oci-client@^0.0.13",
    "semver": "npm:semver@^7.8.5",
    "ts-graphviz": "npm:ts-graphviz@^2.1.6",
    "wildcard-match": "npm:wildcard-match@^5.1.4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./crds": "./src/generated/crds/index.ts"
  },
  "lint": {
    "include": [
      "src/"
    ],
    "exclude": [
      "src/testdata/",
      "src/fixtures/**/*.ts",
      "src/generated/**/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await",
        "no-empty-interface"
      ]
    }
  },
  "fmt": {
    "options": {
      "singleQuote": true
    }
  },
  "test": {
    "include": [
      "src/"
    ],
    "exclude": [
      "src/testdata/",
      "src/fixtures/**/*.ts"
    ]
  },
  "tasks": {
    "run": "deno run --check ./src/index.ts"
  },
  "license": "GPL-3.0-or-later",
  "name": "@glassway/architect-k8s",
  "version": "1.1.0"
}
