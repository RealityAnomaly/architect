{
  "imports": {
    "@es-toolkit/es-toolkit": "jsr:@es-toolkit/es-toolkit@^1.49.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@types/js-yaml": "npm:@types/js-yaml@^4.0.9",
    "@types/lodash": "npm:@types/lodash@^4.17.24",
    "@types/object-hash": "npm:@types/object-hash@^3.0.6",
    "ajv": "npm:ajv@^8.20.0",
    "appdirsjs": "npm:appdirsjs@^1.2.7",
    "js-yaml": "npm:js-yaml@^4.3.0",
    "object-hash": "npm:object-hash@^3.0.0",
    "reflect-metadata": "npm:reflect-metadata@^0.2.2",
    "ts-graphviz": "npm:ts-graphviz@^2.1.6",
    "wildcard-match": "npm:wildcard-match@^5.1.4"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "lint": {
    "include": [
      "src/"
    ],
    "exclude": [
      "src/testdata/",
      "src/fixtures/**/*.ts",
      "src/generated/**/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await",
        "no-empty-interface"
      ]
    }
  },
  "fmt": {
    "options": {
      "singleQuote": true
    }
  },
  "test": {
    "include": [
      "src/"
    ],
    "exclude": [
      "src/testdata/",
      "src/fixtures/**/*.ts"
    ]
  },
  "tasks": {
    "generate": "deno --allow-net --allow-env --allow-sys --allow-read --allow-run=deno --allow-write scripts/generate.ts"
  },
  "license": "GPL-3.0-or-later",
  "name": "@glassway/architect",
  "version": "1.0.7"
}
