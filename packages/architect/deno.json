{
  "imports": {
    "@deno-library/progress": "jsr:@deno-library/progress@^1.5.1",
    "@es-toolkit/es-toolkit": "jsr:@es-toolkit/es-toolkit@^1.49.0",
    "@types/js-yaml": "npm:@types/js-yaml@^4.0.9",
    "@types/lodash": "npm:@types/lodash@^4.17.24",
    "@types/object-hash": "npm:@types/object-hash@^3.0.6",
    "ajv": "npm:ajv@^8.20.0",
    "ajv-formats": "npm:ajv-formats@^3.0.1",
    "ajv-formats-draft2019": "npm:ajv-formats-draft2019@^1.6.1",
    "ajv-i18n": "npm:ajv-i18n@^4.2.0",
    "appdirsjs": "npm:appdirsjs@^1.2.7",
    "commander": "npm:commander@^12.1.0",
    "is-cidr": "npm:is-cidr@^7.0.0",
    "js-yaml": "npm:js-yaml@^4.3.0",
    "lodash": "npm:lodash@^4.18.1",
    "object-hash": "npm:object-hash@^3.0.0",
    "openapi-types": "npm:openapi-types@^12.1.3",
    "reflect-metadata": "npm:reflect-metadata@^0.2.2",
    "ts-graphviz": "npm:ts-graphviz@^2.1.6",
    "wildcard-match": "npm:wildcard-match@^5.1.4",
    "winston": "npm:winston@^3.19.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./kubernetes/generate": "./src/kubernetes/generate/index.ts",
    "./kubernetes/validate": "./src/kubernetes/validate/index.ts",
    "./kubernetes/types": "./src/kubernetes/types/index.ts",
    "./kubernetes/models": "./src/kubernetes/models/index.ts",
    "./kubernetes/apimachinery": "./src/kubernetes/apimachinery/index.ts",
    "./kubernetes/apimachinery/apis/meta/v1/ObjectMeta": "./src/kubernetes/apimachinery/apis/meta/v1/ObjectMeta.ts",
    "./kubernetes/apimachinery/_schemas/IoK8sApimachineryPkgApisMetaV1ObjectMeta": "./src/kubernetes/apimachinery/_schemas/IoK8sApimachineryPkgApisMetaV1ObjectMeta.js"
  },
  "lint": {
    "include": [
      "src/"
    ],
    "exclude": [
      "src/testdata/",
      "src/fixtures/**/*.ts",
      "src/generated/**/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "require-await",
        "no-empty-interface"
      ]
    }
  },
  "fmt": {
    "options": {
      "singleQuote": true
    }
  },
  "test": {
    "include": [
      "src/"
    ],
    "exclude": [
      "src/testdata/",
      "src/fixtures/**/*.ts"
    ]
  },
  "tasks": {
    "generate": "deno --allow-net --allow-env --allow-sys --allow-read --allow-run=deno --allow-write scripts/generate.ts"
  },
  "license": "GPL-3.0-or-later",
  "name": "@glassway/architect",
  "version": "1.0.7"
}
